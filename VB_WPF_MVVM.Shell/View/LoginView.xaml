<UserControl x:Class="LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:p="clr-namespace:VB_WPF_MVVM.Localization;assembly=VB_WPF_MVVM.Localization"
             mc:Ignorable="d"
             xmlns:Prism="http://www.codeplex.com/prism"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="700" d:DesignWidth="1300" >
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedLangue.LanguageID}" Value="0">
                    <Setter Property="FlowDirection" Value="RightToLeft"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedLangue.LanguageID}" Value="1">
                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <!-- Brand gradient backdrop -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF173E63" Offset="0"/>
                <GradientStop Color="#FF11304F" Offset="0.5"/>
                <GradientStop Color="#FF0C2238" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Soft decorative circles -->
        <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-160,-160,0,0" Fill="#22FFFFFF"/>
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-120,-120" Fill="#1AFFFFFF"/>

        <!-- Login card -->
        <materialDesign:Card Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ShadowAssist.ShadowDepth="Depth4"
                             Background="White">
            <StackPanel>

                <!-- Branded header -->
                <Grid Height="150">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF2778BB" Offset="0"/>
                            <GradientStop Color="#FF1EDFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="76" Height="76" CornerRadius="38" Background="#33FFFFFF"
                                HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldAccount" Width="40" Height="40"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Your System Name" Foreground="White"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   FontSize="18" FontWeight="Bold" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Form -->
                <StackPanel Margin="28,26,28,8">
                    <TextBlock Text="{x:Static p:Translations.Login}" Foreground="#FF2C3E50"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>

                    <TextBox materialDesign:HintAssist.Hint="{x:Static p:Translations.UserName}"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             FontSize="14" Margin="0,0,0,14">
                        <materialDesign:HintAssist.Background>
                            <SolidColorBrush Color="White"/>
                        </materialDesign:HintAssist.Background>
                    </TextBox>

                    <PasswordBox Name="Password"
                                 materialDesign:HintAssist.Hint="{x:Static p:Translations.Password}"
                                 materialDesign:HintAssist.IsFloating="True"
                                 FontSize="14" Margin="0,0,0,14">
                        <PasswordBox.InputBindings>
                            <KeyBinding Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=Password}" Key="Enter"/>
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <ComboBox materialDesign:HintAssist.Hint="Language"
                              materialDesign:HintAssist.IsFloating="True"
                              FontSize="14" Margin="0,0,0,22"
                              ItemsSource="{Binding LangueList}" SelectedItem="{Binding SelectedLangue}"
                              DisplayMemberPath="LanguageName" SelectedValuePath="LanguageID"/>

                    <Button Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=Password}"
                            Height="44" FontWeight="Bold" FontSize="14" Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF2778BB" Offset="0"/>
                                <GradientStop Color="#FF1EA7E8" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="LoginVariant" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static p:Translations.Login}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Margin="0,4,0,16">
                    <Separator Margin="28,0" Background="#FFEAEEF2"/>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="8"
                               Foreground="#FF9AA7B4" FontSize="11">
                        <Run Text="Copyright "/>
                        <Run FontWeight="Bold" Text="Binary"/>
                        <Run Text=" — All rights reserved"/>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
