<UserControl x:Name="userControl" x:Class="MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VB_WPF_MVVM.Shell"
             xmlns:p="clr-namespace:VB_WPF_MVVM.Localization;assembly=VB_WPF_MVVM.Localization"
             mc:Ignorable="d" Margin="6"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             WindowChrome.IsHitTestVisibleInChrome="False"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignFont}"
             xmlns:prism="http://www.codeplex.com/prism" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="425" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Brand accent gradient shared by the active-tab bar, indicators and nav highlights -->
        <LinearGradientBrush x:Key="TabAccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF2778BB" Offset="0"/>
            <GradientStop Color="#FF1EDFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Drawer navigation item: icon + label, left accent bar + highlight on hover -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="#CFE3F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="nb" CornerRadius="11" Background="Transparent" Margin="10,3">
                            <Grid>
                                <Border x:Name="bar" Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="2" Background="{StaticResource TabAccentBrush}" Opacity="0"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="nb" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="nb" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern "card" tab -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Header" Value="{Binding Content.DataContext.MainHeadar, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid x:Name="root" Margin="0,6,0,-1">
                            <Border x:Name="bg" CornerRadius="12,12,0,0" Background="#1FFFFFFF" SnapsToDevicePixels="True"/>
                            <Border x:Name="accent" Height="3" VerticalAlignment="Top"
                                    CornerRadius="12,12,0,0" Opacity="0"
                                    Background="{StaticResource TabAccentBrush}"/>
                            <StackPanel Orientation="Horizontal" Height="34" Margin="16,0,11,0" VerticalAlignment="Center">
                                <Ellipse x:Name="dot" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" Fill="#66FFFFFF"/>
                                <ContentPresenter x:Name="cp" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <Button x:Name="CloseTab" Width="22" Height="22" Padding="0" Margin="12,0,0,0"
                                        Cursor="Hand" Visibility="Hidden" ToolTip="Close"
                                        Command="{Binding DataContext.CloseTab, ElementName=userControl}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cbg" Width="22" Height="22" CornerRadius="11" Background="Transparent">
                                                <materialDesign:PackIcon Kind="Close" Width="13" Height="13"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cbg" Property="Background" Value="#22000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#FF2C3E50"/>
                                <Setter TargetName="dot" Property="Fill" Value="{StaticResource TabAccentBrush}"/>
                                <Setter TargetName="accent" Property="Opacity" Value="1"/>
                                <Setter TargetName="CloseTab" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="11" ShadowDepth="0" Opacity="0.16" Color="#FF0B3A5E"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="dot" Property="Fill" Value="#CCFFFFFF"/>
                                <Setter TargetName="CloseTab" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab strip: headers indented to clear the menu button; flat white content so tabs merge with no gaps -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1"
                                      Margin="52,0,0,0" IsItemsHost="True" Background="Transparent"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border x:Name="ContentPanel" Grid.Row="1" Background="White" CornerRadius="0"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- DrawerHost = the hidden overlay navigation drawer (opens on click, closes on click-away / on navigate) -->
    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding EnableDisable, Mode=TwoWay, FallbackValue=false}">

        <!-- ===== Drawer content (the navigation panel) ===== -->
        <materialDesign:DrawerHost.LeftDrawerContent>
            <Border Width="280">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF15395B" Offset="0"/>
                        <GradientStop Color="#FF0E2A47" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel LastChildFill="True">

                    <!-- Brand -->
                    <Grid DockPanel.Dock="Top" Height="78">
                        <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource TabAccentBrush}">
                                <materialDesign:PackIcon Kind="ShieldAccount" Width="24" Height="24" Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Your System" Foreground="White" FontSize="15.5" FontWeight="Bold"/>
                                <TextBlock Text="Workspace" Foreground="#7FB4D8" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- User + logout (bottom) -->
                    <Border DockPanel.Dock="Bottom" Height="72" Background="#14FFFFFF">
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource TabAccentBrush}">
                                <materialDesign:PackIcon Kind="Account" Width="23" Height="23" Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Administrator" Foreground="#7FB4D8" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="2" ToolTip="{x:Static p:Translations.Logout}" Command="{Binding CloseAllTabs}"
                                    Cursor="Hand" Width="40" Height="40" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="lb" CornerRadius="10" Background="Transparent">
                                            <materialDesign:PackIcon Kind="Logout" Width="21" Height="21" Foreground="#CFE3F2"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="lb" Property="Background" Value="#26FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Navigation items (each navigates and closes the drawer) -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="MENU" Foreground="#5E89AE" FontSize="11" FontWeight="SemiBold" Margin="28,4,0,8"/>
                        <Button Style="{StaticResource NavItem}" Command="{Binding HomeViewCommand}">
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static p:Translations.Dashboard}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavItem}" Command="{Binding Screen1ViewCommand}">
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                <materialDesign:PackIcon Kind="Monitor" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static p:Translations.Screen1}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavItem}" Command="{Binding Screen2ViewCommand}">
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static p:Translations.Screen2}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <!-- ===== Main content: open pages (tabs) + the menu button ===== -->
        <Grid Background="Transparent">
            <TabControl prism:RegionManager.RegionName="MainRegion"/>

            <!-- Menu button: opens the drawer -->
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,6,0,0"
                    Width="44" Height="40" Cursor="Hand"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="Transparent" BorderThickness="0" Foreground="White"
                    ToolTip="Menu"
                    Visibility="{Binding IsLogedIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                    CommandParameter="{x:Static Dock.Left}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="mb" CornerRadius="9" Background="Transparent">
                            <materialDesign:PackIcon Kind="Menu" Width="24" Height="24"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="mb" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </materialDesign:DrawerHost>
</UserControl>
